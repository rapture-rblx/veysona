# End-to-end release test of actual WAV and MIDI processing commands.
# Expects -DVEYSONA_TOOL -DVEYSONA_SAMPLE -DVEYSONA_TEST_OUTPUT.
if(NOT DEFINED VEYSONA_TOOL OR NOT EXISTS "${VEYSONA_TOOL}")
 message(FATAL_ERROR "Missing compiled Veysona audio tool")
endif()
if(NOT DEFINED VEYSONA_SAMPLE OR NOT EXISTS "${VEYSONA_SAMPLE}")
 message(FATAL_ERROR "Missing reference WAV sample")
endif()
file(REMOVE_RECURSE "${VEYSONA_TEST_OUTPUT}")
file(MAKE_DIRECTORY "${VEYSONA_TEST_OUTPUT}/slices")
function(check_command result_text)
 execute_process(COMMAND "${VEYSONA_TOOL}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 65)
 if(NOT "${code}" STREQUAL "0")
  message(FATAL_ERROR "Tool failed: ${ARGN}\nExit: ${code}\nStdout: ${output}\nStderr: ${errors}")
 endif()
 if(NOT "${output}" MATCHES "${result_text}")
  message(FATAL_ERROR "Unexpected tool output for ${ARGN}: ${output}")
 endif()
endfunction()
check_command("Estimated BPM: 120" analyze "${VEYSONA_SAMPLE}")
check_command("approximate loudness" master "${VEYSONA_SAMPLE}" "${VEYSONA_TEST_OUTPUT}/master.wav" -17 -1)
check_command("Resampled to 44100" resample "${VEYSONA_SAMPLE}" "${VEYSONA_TEST_OUTPUT}/resampled.wav" 44100)
check_command("Saved [0-9]+ slices" slice "${VEYSONA_SAMPLE}" "${VEYSONA_TEST_OUTPUT}/slices")
check_command("Generated 12 MIDI chord" chords "${VEYSONA_TEST_OUTPUT}/chords.mid" 60 120)
check_command("MIDI drum" drums "${VEYSONA_TEST_OUTPUT}/drums.mid" 120 1234)
foreach(name master.wav resampled.wav chords.mid drums.mid)
 file(SIZE "${VEYSONA_TEST_OUTPUT}/${name}" len)
 if(len LESS 30)
 message(FATAL_ERROR "Output ${name} is empty")
endif()
endforeach()
file(GLOB slice_files "${VEYSONA_TEST_OUTPUT}/slices/*.wav")
list(LENGTH slice_files slices)
if(slices LESS 2)
 message(FATAL_ERROR "Transient slicing didn't produce multiple WAVs")
endif()
execute_process(COMMAND "${VEYSONA_TOOL}" master "${VEYSONA_SAMPLE}" "${VEYSONA_SAMPLE}" RESULT_VARIABLE invalid ERROR_QUIET OUTPUT_QUIET TIMEOUT 15)
if("${invalid}" STREQUAL "0")
 message(FATAL_ERROR "Unsafe overwriting of input was accepted")
endif()
message(STATUS "CLI end-to-end production tests passed (${slices} WAV slices)")
